{
  "$comment": "The site's design tokens. This file is the source of truth: `pnpm tokens` writes it to app/tokens.css, and /work/design-system reads it for the swatch grid. Keys starting with $ are notes, not tokens.",
  "color": {
    "$comment": "Four text steps, two accents, one line. Status colours are for a check result only.",
    "ink": "#0c0810",
    "ink-2": "#100913",
    "plum": "rgba(74, 28, 47, 0.28)",
    "cream": "#f2e8dc",
    "text-strong": "#f2e2d9",
    "text": "#d8cdc8",
    "text-muted": "#b9aead",
    "text-faint": "#897e80",
    "rose": "#d97b72",
    "peach": "#e9a27d",
    "line": "rgba(242, 232, 220, 0.14)",
    "fill": "rgba(255, 255, 255, 0.02)",
    "fill-soft": "rgba(255, 255, 255, 0.015)",
    "plate": "linear-gradient(160deg, #f6f2ec, #e9e1d6)",
    "page-gradient": "linear-gradient(180deg, #0b0710 0%, #0d0811 58%, #100913 100%)",
    "pass": "#7fc49a",
    "fail": "#e3675f"
  },
  "alpha": {
    "$comment": "Derived accent states: a base colour mixed with transparent at a percentage. Never a new hex.",
    "rose-6": { "of": "rose", "percent": 6 },
    "rose-10": { "of": "rose", "percent": 10 },
    "rose-20": { "of": "rose", "percent": 20 },
    "rose-24": { "of": "rose", "percent": 24 },
    "rose-28": { "of": "rose", "percent": 28 },
    "rose-35": { "of": "rose", "percent": 35 },
    "rose-40": { "of": "rose", "percent": 40 },
    "peach-45": { "of": "peach", "percent": 45 },
    "peach-55": { "of": "peach", "percent": 55 },
    "cream-8": { "of": "cream", "percent": 8 },
    "cream-18": { "of": "cream", "percent": 18 },
    "cream-60": { "of": "cream", "percent": 60 },
    "cream-75": { "of": "cream", "percent": 75 },
    "ink-55": { "of": "ink", "percent": 55 },
    "ink-80": { "of": "ink", "percent": 80 },
    "ink-97": { "of": "ink-2", "percent": 97 }
  },
  "type": {
    "$comment": "One oversized display size, then clear steps down. font-mono is for code only.",
    "text-display": "clamp(3rem, 1.6rem + 5.2vw, 6rem)",
    "text-title": "clamp(2.5rem, 1.5rem + 2.6vw, 4rem)",
    "text-heading": "clamp(1.875rem, 1.4rem + 1.2vw, 2.75rem)",
    "text-pull": "clamp(1.5rem, 1.2rem + 1.1vw, 2.125rem)",
    "text-subheading": "clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem)",
    "text-numeral-lg": "46px",
    "text-numeral": "22px",
    "text-metric": "clamp(44px, 5vw, 68px)",
    "text-lead": "clamp(1.125rem, 1rem + 0.4vw, 1.25rem)",
    "text-body": "1rem",
    "text-small": "0.875rem",
    "text-label": "0.75rem",
    "text-micro": "0.6875rem",
    "font-mono": "ui-monospace, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace",
    "leading-display": "0.95",
    "tracking-display": "-0.035em",
    "tracking-tight": "-0.02em",
    "tracking-caps": "0.16em"
  },
  "space": {
    "$comment": "Vertical rhythm. Every section uses one of the three steps; the scale steps down together at each breakpoint.",
    "space-section": "160px",
    "space-inner": "104px",
    "space-top": "88px",
    "gap-lg": "48px",
    "gap-md": "24px",
    "gap-sm": "12px",
    "pad-card": "32px",
    "max-width-shell": "1200px"
  },
  "radius": {
    "$comment": "Four values. The drawn iPhone uses container units of its own.",
    "radius-sm": "8px",
    "radius-md": "16px",
    "radius-lg": "24px",
    "radius-pill": "999px"
  },
  "shadow": {
    "$comment": "Only things that float cast a shadow.",
    "shadow-card": "0 24px 60px rgba(6, 3, 10, 0.45)",
    "shadow-card-hover": "0 34px 80px rgba(6, 3, 10, 0.65)",
    "shadow-plate": "0 40px 80px -48px rgba(0, 0, 0, 0.75)"
  },
  "motion": {
    "$comment": "One arrival curve; the lights drift on their own.",
    "ease-out": "cubic-bezier(0.22, 1, 0.36, 1)",
    "ease-drift": "cubic-bezier(0.45, 0, 0.55, 1)",
    "dur-fast": "200ms",
    "dur-base": "400ms",
    "dur-slow": "700ms"
  },
  "focus": {
    "$comment": "A two-layer ring that reads on any surface.",
    "focus-ring": "0 0 0 2px var(--ink), 0 0 0 4px var(--rose)"
  },
  "breakpoints": {
    "$comment": "Overrides applied at max-width. Two breakpoints, nothing else.",
    "1024px": {
      "space-section": "120px",
      "space-inner": "80px",
      "space-top": "64px",
      "gap-lg": "28px",
      "gap-md": "20px",
      "pad-card": "24px"
    },
    "640px": {
      "space-section": "88px",
      "space-inner": "56px",
      "space-top": "48px",
      "gap-lg": "18px",
      "gap-md": "16px",
      "gap-sm": "10px",
      "pad-card": "20px",
      "text-numeral-lg": "40px"
    }
  }
}
